{
  "name": "alpha",
  "version": "0.1.27",
  "description": "Desktop GUI for pi with its own embedded pi runtime",
  "homepage": "https://github.com/alpha-app/alpha",
  "author": {
    "name": "Alpha",
    "email": "maintainer@alpha.local"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "npm run build && ALPHA_SMOKE=1 electron out/main/index.js",
    "check:renderer": "node tests/renderer-check.mjs",
    "pkg": "electron-vite build && electron-builder --linux dir && makepkg -f && bash scripts/local-repo.sh",
    "repo": "bash scripts/local-repo.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.alpha.app",
    "productName": "Alpha",
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "asarUnpack": [
      "node_modules/@earendil-works/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "maintainer@alpha.local",
      "synopsis": "Desktop GUI for pi"
    }
  }
}
